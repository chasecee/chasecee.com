{
  "headers": [
    {
      "source": "/icons/site/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=15552000"
        }
      ]
    },
    {
      "source": "/icons/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=15552000"
        }
      ]
    },
    {
      "source": "/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/halftone/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/v/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:file(me.webp|noise1.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:file(.*\\.pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/js/pa.js",
      "destination": "https://t.chasecee.com/js/pa-U1IxySuA2Noz1-DkNP-zD.js"
    },
    {
      "source": "/js/event",
      "destination": "https://t.chasecee.com/api/event"
    },
    {
      "source": "/js/event/",
      "destination": "https://t.chasecee.com/api/event"
    },
    {
      "source": "/js/u.js",
      "destination": "https://u.chasecee.com/script.js"
    },
    {
      "source": "/js/ur.js",
      "destination": "https://u.chasecee.com/recorder.js"
    },
    {
      "source": "/js/api/send",
      "destination": "https://u.chasecee.com/api/send"
    },
    {
      "source": "/js/api/record",
      "destination": "https://u.chasecee.com/api/record"
    },
    {
      "source": "/js/api/websites/:id/recorder",
      "destination": "https://u.chasecee.com/api/websites/:id/recorder"
    }
  ],
  "redirects": [
    {
      "source": "/studio",
      "destination": "https://chasecee.sanity.studio",
      "permanent": false
    },
    {
      "source": "/studio/:path*",
      "destination": "https://chasecee.sanity.studio/:path*",
      "permanent": false
    }
  ]
}
