---
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import Container from "@/src/components/Container.astro";
import LucideIcon from "@/src/components/icons/LucideIcon.astro";
import { LUCIDE_ICONS } from "@/src/components/icons/lucide";

export const prerender = false;

Astro.response.status = 404;
---

<SiteLayout
  title="You Lost? - Chase Cee"
  description="This page doesn't exist. Head on back to town."
>
  <Container>
    <div class="prose prose-flow mt-10">
      <div
        class="mx-auto flex max-w-3xl flex-col items-start gap-2 py-16 text-left md:items-center md:text-center"
      >
        <p class="not-prose m-0 font-mono text-sm tracking-widest opacity-50">
          404
        </p>
        <h1
          class="not-prose m-0 text-[clamp(2.4rem,8vw,4.3rem)] leading-[1.05]"
        >
          You lost, partner?
        </h1>
        <a
          href="/"
          class="not-prose group mt-4 inline-flex items-center justify-center gap-x-3 rounded-[.25rem] border-0 bg-indigo-600 px-6 py-3 text-base text-white no-underline shadow-xs ring-site ring-indigo-300 transition-colors hover:bg-indigo-700 dark:bg-indigo-500/20 dark:ring-indigo-300/20 dark:hover:bg-indigo-500/35"
        >
          Take me home, country road
          <LucideIcon
            icon={LUCIDE_ICONS.chevronRight}
            size={12}
            class="transition-transform duration-200 [@media(hover:hover)_and_(pointer:fine)]:group-hover:translate-x-1 group-active:translate-x-1"
          />
        </a>
      </div>
    </div>
  </Container>
</SiteLayout>
