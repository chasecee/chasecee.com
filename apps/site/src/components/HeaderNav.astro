---
import NavActiveIndicator from "./NavActiveIndicator.astro";

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
const normalizedActivePath =
  activePath !== "/" && activePath.endsWith("/")
    ? activePath.slice(0, -1)
    : activePath;
const isMusicPath =
  normalizedActivePath === "/music" ||
  normalizedActivePath.startsWith("/music/");
const baseClass =
  "header_item focus-ring no-underline transition-opacity group relative";
---

<div
  class="header_menu flex flex-row justify-end md:justify-center items-center gap-3 sm:gap-5 md:gap-6 grow"
>
  <a
    href="/"
    class:list={[
      baseClass,
      normalizedActivePath === "/" ? "item_active" : "item_inactive",
    ]}
  >
    Work
    {normalizedActivePath === "/" && <NavActiveIndicator />}
  </a>
  <a
    href="/music"
    class:list={[baseClass, isMusicPath ? "item_active" : "item_inactive"]}
  >
    Music
    {isMusicPath && <NavActiveIndicator />}
  </a>
  <a
    href="/about"
    class:list={[
      baseClass,
      normalizedActivePath === "/about" ? "item_active" : "item_inactive",
    ]}
  >
    About
    {normalizedActivePath === "/about" && <NavActiveIndicator />}
  </a>
</div>

<style>
  /* Rest state is muted and hover resolves to full strength, so hovering
     gains contrast. The previous rule faded to 0.5 (3.7:1) on hover. */
  .item_inactive {
    opacity: 0.7;
  }

  .item_inactive:hover,
  .item_inactive:focus-visible {
    opacity: 1;
  }

  .item_active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .header_item {
      transition: none;
    }
  }
</style>
