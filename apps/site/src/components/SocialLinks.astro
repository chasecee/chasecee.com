---
import LucideIcon from "./icons/LucideIcon.astro";
import { GithubIcon, LinkedInIcon } from "./icons";
import { LUCIDE_ICONS } from "./icons/lucide";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["flex items-center gap-5 pt-px sm:gap-6", className]}>
  <a
    href="https://github.com/chasecee/"
    target="_blank"
    rel="noopener noreferrer"
    class="focus-ring inline-flex items-center gap-1.5 opacity-70 transition-opacity hover:opacity-100"
    title="GitHub"
  >
    <GithubIcon size={16} className="opacity-50" />
    <span>GitHub</span>
  </a>
  <a
    href="https://www.linkedin.com/in/chasechristensen-1/"
    target="_blank"
    rel="noopener noreferrer"
    class="focus-ring inline-flex items-center gap-1.5 opacity-70 transition-opacity hover:opacity-100"
    title="LinkedIn"
  >
    <LinkedInIcon size={16} className="opacity-50" />
    <span>LinkedIn</span>
  </a>
  <a
    href="/Chase_Christensen_Resume-2026.pdf"
    target="_blank"
    rel="noopener noreferrer"
    class="focus-ring inline-flex items-center gap-1.5 opacity-70 transition-opacity hover:opacity-100"
    title="Resume"
  >
    <LucideIcon icon={LUCIDE_ICONS.fileText} size={16} class="opacity-50" />
    <span>Resume</span>
  </a>
</div>
